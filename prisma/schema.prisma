generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model ServerEntity {
  id Int @id
  serverId String @unique
  name String
  language String
  createdAt DateTime
  updatedAt DateTime
  games GameEntity[]
}

model GameEntity {
  id Int @id
  gameId String @unique
  type String
  serverId Int
  data String
  createdAt DateTime
  updatedAt DateTime
  server ServerEntity @relation(fields: [serverId], references: [id])
}

model GameDataEntity {
  id Int @id
  gameId Int
  serverId String
  channelId String @unique
  messageId String
  lastUserId String
  answer String
  createdAt DateTime
  updatedAt DateTime
}

