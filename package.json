{
  "name": "disgames",
  "version": "3.0.0",
  "description": "Minigame bot",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "watch": "tsc -w",
    "deploy": "npm run build && node dist/deploy-commands.js",
    "job": "ts-node src/job-runner.ts",
    "db:down": "ts-node src/utils/database/GenerateSchema.ts",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "test": "ts-node --project tests/tsconfig.json tests/TestRunner.ts",
    "test:unit": "ts-node --project tests/tsconfig.json tests/TestRunner.ts --unit",
    "test:integration": "ts-node --project tests/tsconfig.json tests/TestRunner.ts --integration",
    "test:performance": "ts-node --project tests/tsconfig.json tests/TestRunner.ts --performance",
    "test:coverage": "ts-node --project tests/tsconfig.json tests/TestRunner.ts --coverage",
    "test:debug": "ts-node --project tests/tsconfig.json tests/TestRunner.ts --debug"
  },
  "dependencies": {
    "@discordjs/builders": "^1.7.0",
    "@discordjs/rest": "^2.2.0",
    "axios": "^1.8.4",
    "canvas": "^3.2.0",
    "chokidar": "^4.0.3",
    "cors": "^2.8.5",
    "discord-api-types": "^0.37.70",
    "discord.js": "^14.19.3",
    "dotenv": "^16.3.1",
    "express": "^5.1.0",
    "mysql2": "^3.14.2",
    "node-schedule": "^2.1.1",
    "reflect-metadata": "^0.2.1",
    "zod": "^3.23.8",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^20.10.0",
    "@types/node-schedule": "^2.1.7",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "eslint": "^9.36.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  },
  "findUnusedExports": {
    "include": [
      "./src/**/*.ts",
      "./tests/**/*.test.ts"
    ],
    "exclude": [
      "./node_modules/**/*",
      "./dist/**/*"
    ]
  }
}
