{
  "name": "DisGames",
  "version": "3.1.0",
  "github": "https://github.com/MielVelden/DisGames",
  "description": "Minigame bot",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "handoff": "node dist/index.js --standby",
    "dev": "tsc && node dist/index.js",
    "dev:watch": "tsx watch src/index.ts",
    "watch": "tsc -w",
    "deploy": "npm run build && node dist/deploy-commands.js",
    "job": "ts-node src/job-runner.ts",
    "db:down": "ts-node src/db-down.ts",
    "db:up": "ts-node src/db-up.ts",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "test": "ts-node --project tests/tsconfig.json tests/Run.ts",
    "test:performance": "ts-node --project tests/tsconfig.json tests/Run.ts --performance",
    "test:debug": "ts-node --project tests/tsconfig.json tests/Run.ts --debug",
    "test:all": "tsx --tsconfig tests/tsconfig.json tests/Run.ts --all"
  },
  "dependencies": {
    "@discordjs/builders": "^1.7.0",
    "@discordjs/rest": "^2.2.0",
    "@toon-format/toon": "^2.2.0",
    "axios": "^1.8.4",
    "canvas": "^3.2.0",
    "chokidar": "^4.0.3",
    "cors": "^2.8.5",
    "discord-api-types": "^0.37.70",
    "discord.js": "^14.19.3",
    "dotenv": "^16.3.1",
    "express": "^5.1.0",
    "humanize-duration": "^3.33.2",
    "mysql2": "^3.14.2",
    "node-schedule": "^2.1.1",
    "reflect-metadata": "^0.2.1",
    "ws": "^8.18.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/humanize-duration": "^3.27.4",
    "@types/node": "^20.10.0",
    "@types/node-schedule": "^2.1.7",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "eslint": "^9.36.0",
    "ts-node": "^10.9.1",
    "tsx": "^4.21.0",
    "typescript": "^5.3.2"
  },
  "findUnusedExports": {
    "include": [
      "./src/**/*.ts",
      "./tests/**/*.test.ts"
    ],
    "exclude": [
      "./node_modules/**/*",
      "./dist/**/*"
    ]
  }
}
